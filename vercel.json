{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "GO_LIVE_AUDIT_ALLOW_UI_SMTP": "1"
  },
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --omit=dev --ignore-scripts",
  "buildCommand": "npm run build",
  "functions": {
    "api/scan.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/ping.js": {
      "memory": 128
    },
    "api/runtime.js": {
      "memory": 128
    },
    "api/email-status.js": {
      "memory": 128
    }
  }
}
