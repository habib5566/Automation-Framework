# Base URL for the app under test (demo server default)
BASE_URL=http://localhost:3789

# Staging AutobotX dashboard (used only by --project=staging-autobotx)
# STAGING_BASE_URL=https://staging-dashboard.autobotx.ai

# Valid credentials (must match fixtures/demo-app behavior)
VALID_USERNAME=admin
VALID_PASSWORD=admin123

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Video (needs Playwright ffmpeg). Leave unset or 0 to avoid ffmpeg; use 1 to record on failures
# PW_RECORD_VIDEO=0

# Go-Live Audit — Gmail report (required when Report email is @gmail.com)
# Uncomment and fill — smtp.gmail.com is inferred from @gmail.com user; restart `npm run go-live:audit` after saving.
# GO_LIVE_AUDIT_SMTP_USER=you@gmail.com
# GO_LIVE_AUDIT_SMTP_PASS=your-google-app-password
# GO_LIVE_AUDIT_EMAIL_FROM=you@gmail.com
# Optional: corporate TLS on SMTP — GO_LIVE_AUDIT_SMTP_TLS_REJECT_UNAUTHORIZED=0
# Local Mailpit only (ignores Gmail rule): GO_LIVE_AUDIT_ALLOW_MAILPIT_FOR_GMAIL=1

# Optional: disable auto Mailpit when no SMTP host (local audit server only)
# GO_LIVE_AUDIT_NO_DEFAULT_SMTP=1

# Local Mailpit explicit (optional; otherwise 127.0.0.1:1025 when no GO_LIVE_AUDIT_SMTP_USER):
# GO_LIVE_AUDIT_SMTP_HOST=127.0.0.1
# GO_LIVE_AUDIT_SMTP_PORT=1025
# GO_LIVE_AUDIT_SMTP_SECURE=0
# GO_LIVE_AUDIT_EMAIL_FROM=audit@localhost
# GO_LIVE_AUDIT_DISALLOW_UI_RECIPIENT=1
